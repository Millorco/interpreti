# Cartella da caricare sul server (contenuto di "www").
# Queste regole proteggono i file non pubblici (configurazione, file .sql) e rimandano i visitatori alla sottocartella public/.
# Se possibile, impostare comunque la document root del sito su "public".

Options -Indexes

<FilesMatch "^(README\.md|\.gitignore|config(\.sample)?\.php|.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Il percorso viene preso dall'URL richiesto, così il redirect funziona
    # sia nella radice del sito sia in una sottocartella.
    RewriteCond %{REQUEST_URI} ^(.*)/$
    RewriteRule ^$ %1/public/ [R=302,L]
</IfModule>
